# Secret used to sign and verify JWTs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="JWT_SECRET1"

# Database connection.
# The defaults below match the local dev setup, so leaving these unset works
# for development. In production (NODE_ENV=production) DB_HOST, DB_NAME,
# DB_USER and DB_PASSWORD are required and the app refuses to start without
# them. DB_PORT and DB_SCHEMA stay optional.
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="mymlpractice-dev"
DB_USER="postgres"
DB_PASSWORD=""
DB_SCHEMA="public"
