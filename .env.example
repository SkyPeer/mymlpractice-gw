# Secret used to sign and verify JWTs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="JWT_SECRET1"

# === === === ===

# Secret mixed into every password hash before bcrypt (a "pepper"). Lives only
# here, never in the database. Back it up with the same care as the database:
# changing or losing it makes every stored password unverifiable.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASSWORD_PEPPER="PASSWORD_PEPPER"

# === === === ===

# Database connection.
# The defaults below match the local dev setup, so leaving these unset works
# for development. In production (NODE_ENV=production) DB_HOST, DB_NAME,
# DB_USER and DB_PASSWORD are required and the app refuses to start without
# them. DB_PORT and DB_SCHEMA stay optional.
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="mymlpractice-dev"
DB_USER="postgres"
DB_PASSWORD=""
DB_SCHEMA="public"

# === === === ===

# Admin account created by `npm run db:seed`. The password is plain text and is
# hashed during the seed with this machine's PASSWORD_PEPPER, so set that
# first. All three are required for the first seed; delete them from .env right
# after it - the admin seed never runs again on the same database. Quote the
# password: an unquoted # would start a comment.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_EMAIL="admin@localhost.local"
SEED_ADMIN_PASSWORD=''

# === === === ===
